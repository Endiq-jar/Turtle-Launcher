<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingBottom="@dimen/_8sdp"
    android:baselineAligned="true"
    android:minWidth="@dimen/dialog_min_width"
    tools:ignore="ContentDescription">

    <ImageView
        android:id="@+id/close_button"
        android:layout_width="@dimen/_18sdp"
        android:layout_height="@dimen/_18sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_16sdp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/title_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:singleLine="true"
            android:text="@string/file_tips"
            android:textColor="@color/turtle_primary_text"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ScrollView
            android:id="@+id/text_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_weight="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_view">

            <LinearLayout
                android:id="@+id/layout1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/message_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/_8sdp"
                    android:gravity="center_horizontal"
                    android:textColor="@color/turtle_primary_text"
                    android:textSize="@dimen/_12ssp" />
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/layout_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:orientation="vertical"
        app:layout_constraintEnd_toStartOf="@+id/layout_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout">

        <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
            android:id="@+id/copy_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48sdp"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/copy_image"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_22sdp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_copy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_toEndOf="@+id/copy_image"
                android:singleLine="true"
                android:text="@android:string/copy"
                android:textColor="@color/turtle_primary_text"
                android:textSize="@dimen/_14ssp" />
        </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

        <!-- ── Edit (open in in-launcher text editor; single non-binary file only) ── -->
        <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
            android:id="@+id/edit_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48sdp"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/edit_image"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_22sdp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_document" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_toEndOf="@+id/edit_image"
                android:singleLine="true"
                android:text="@string/generic_edit"
                android:textColor="@color/turtle_primary_text"
                android:textSize="@dimen/_14ssp" />
        </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

        <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
            android:id="@+id/rename_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48sdp"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/rename_image"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_22sdp"
                android:scaleType="fitCenter"
                android:scaleX="0.8"
                android:scaleY="0.8"
                android:src="@drawable/ic_edit" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_toEndOf="@+id/rename_image"
                android:singleLine="true"
                android:text="@string/generic_rename"
                android:textColor="@color/turtle_primary_text"
                android:textSize="@dimen/_14ssp" />
        </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

        <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
            android:id="@+id/share_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48sdp"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/share_image"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_22sdp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_share" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_toEndOf="@+id/share_image"
                android:singleLine="true"
                android:text="@string/generic_share"
                android:textColor="@color/turtle_primary_text"
                android:textSize="@dimen/_14ssp" />
        </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/layout_1"
        app:layout_constraintTop_toBottomOf="@+id/layout">

        <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
            android:id="@+id/move_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48sdp"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/move_image"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_22sdp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_move" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_toEndOf="@+id/move_image"
                android:singleLine="true"
                android:text="@string/generic_move"
                android:textColor="@color/turtle_primary_text"
                android:textSize="@dimen/_14ssp" />
        </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

        <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
            android:id="@+id/delete_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48sdp"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/delete_image"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_22sdp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_menu_delete_forever" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_toEndOf="@+id/delete_image"
                android:singleLine="true"
                android:text="@string/generic_delete"
                android:textColor="@color/turtle_primary_text"
                android:textSize="@dimen/_14ssp" />
        </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

        <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
            android:id="@+id/more_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48sdp"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/more_image"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_22sdp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_more" />

            <TextView
                android:id="@+id/more_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_toEndOf="@+id/more_image"
                android:singleLine="true"
                android:text="@string/generic_more"
                android:textColor="@color/turtle_primary_text"
                android:textSize="@dimen/_14ssp" />
        </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

        <!-- ── Zip (Compress) ─────────────────────────────────────────── -->
        <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
            android:id="@+id/zip_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48sdp"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/zip_image"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_22sdp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_zip" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_toEndOf="@+id/zip_image"
                android:singleLine="true"
                android:text="@string/generic_zip"
                android:textColor="@color/turtle_primary_text"
                android:textSize="@dimen/_14ssp" />
        </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

        <!-- ── Extract (only enabled for .zip files) ──────────────────── -->
        <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
            android:id="@+id/extract_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48sdp"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/extract_image"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_22sdp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_extract" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_toEndOf="@+id/extract_image"
                android:singleLine="true"
                android:text="@string/generic_extract"
                android:textColor="@color/turtle_primary_text"
                android:textSize="@dimen/_14ssp" />
        </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>