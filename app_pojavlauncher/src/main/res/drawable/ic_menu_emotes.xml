<!-- Emotes settings icon. Hand-drawn for TurtleLauncher in the same stroke language as
     the other ic_menu_* icons (2-unit round-cap strokes on a compact viewport): a little
     stick figure waving - head, body, one arm raised with two motion arcs beside the
     hand, the other arm relaxed, legs apart. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="18dp"
    android:tint="@color/black_or_white"
    android:viewportWidth="24"
    android:viewportHeight="18">
  <!-- head -->
  <path
      android:pathData="M5.6,3.6a2.2,2.2 0 1,0 4.4,0a2.2,2.2 0 1,0 -4.4,0"
      android:strokeWidth="2"
      android:fillColor="#00000000"
      android:strokeColor="@color/turtle_primary_text"/>
  <!-- body -->
  <path
      android:pathData="M7.8,6.4L7.8,11.2"
      android:strokeWidth="2"
      android:fillColor="#00000000"
      android:strokeColor="@color/turtle_primary_text"
      android:strokeLineCap="round"/>
  <!-- raised waving arm -->
  <path
      android:pathData="M7.8,7.6L11.6,4.8"
      android:strokeWidth="2"
      android:fillColor="#00000000"
      android:strokeColor="@color/turtle_primary_text"
      android:strokeLineCap="round"/>
  <!-- relaxed arm -->
  <path
      android:pathData="M7.8,7.6L4.8,10"
      android:strokeWidth="2"
      android:fillColor="#00000000"
      android:strokeColor="@color/turtle_primary_text"
      android:strokeLineCap="round"/>
  <!-- legs -->
  <path
      android:pathData="M7.8,11.2L5.4,15.4"
      android:strokeWidth="2"
      android:fillColor="#00000000"
      android:strokeColor="@color/turtle_primary_text"
      android:strokeLineCap="round"/>
  <path
      android:pathData="M7.8,11.2L10.4,15.4"
      android:strokeWidth="2"
      android:fillColor="#00000000"
      android:strokeColor="@color/turtle_primary_text"
      android:strokeLineCap="round"/>
  <!-- wave motion arcs beside the raised hand -->
  <path
      android:pathData="M13.4,2.6A3.6,3.6 0 0,1 14.4,6.2"
      android:strokeWidth="2"
      android:fillColor="#00000000"
      android:strokeColor="@color/turtle_primary_text"
      android:strokeLineCap="round"/>
  <path
      android:pathData="M16.6,1.6A6.6,6.6 0 0,1 18.2,7.4"
      android:strokeWidth="2"
      android:fillColor="#00000000"
      android:strokeColor="@color/turtle_primary_text"
      android:strokeLineCap="round"/>
</vector>
