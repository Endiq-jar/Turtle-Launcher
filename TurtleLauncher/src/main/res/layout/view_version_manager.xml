<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/_240sdp"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_card"
    android:padding="@dimen/_8sdp"
    android:orientation="vertical"
    android:elevation="@dimen/_8sdp"
    android:translationZ="4dp"
    tools:ignore="ContentDescription">

    <!-- TurtleLauncher: this popup's row count grew (goto/game path/rename/copy/export modpack/
         export mrpack/dependency graph/delete = 8 rows) to the point it can be taller than the
         remaining screen space below wherever it's anchored (e.g. tapping "..." on a version
         card near the bottom of the list). It used to have no ScrollView at all and was given a
         raw unbounded measured height in VersionAdapter.showPopupWindow, so the overflow just
         rendered off the bottom of the screen with no way to reach it. ScrollView here plus a
         capped height on the Kotlin side (see showPopupWindow) fixes that together - neither
         alone is enough: without the height cap this never needs to scroll (still oversized);
         without the ScrollView, capping the height would just clip the overflow instead of
         making it reachable. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        
        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:src="@drawable/ic_move" />

        <com.endiq.turtlelauncher.ui.view.AnimTextView
            android:id="@+id/goto_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/background_item"
            android:gravity="center_horizontal"
            android:paddingVertical="@dimen/_12sdp"
            android:paddingHorizontal="@dimen/_20sdp"
            android:text="@string/profiles_path_settings_goto"
            app:ripple_for_text="true"/>
        
    </LinearLayout>
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        
        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:scaleX="0.95"
            android:scaleY="0.95"
            android:src="@drawable/ic_profile_saves" />

        <com.endiq.turtlelauncher.ui.view.AnimTextView
            android:id="@+id/game_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/background_item"
            android:gravity="center_horizontal"
            android:paddingVertical="@dimen/_12sdp"
            android:paddingHorizontal="@dimen/_20sdp"
            android:text="@string/version_manager_shortcuts_version_path"
            app:ripple_for_text="true"/>
        
    </LinearLayout>
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        
        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:scaleX="1.1"
            android:scaleY="1.1"
            android:src="@drawable/ic_edit" />

        <com.endiq.turtlelauncher.ui.view.AnimTextView
            android:id="@+id/rename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/background_item"
            android:gravity="center_horizontal"
            android:paddingVertical="@dimen/_12sdp"
            android:paddingHorizontal="@dimen/_20sdp"
            android:text="@string/version_manager_rename"
            app:ripple_for_text="true"/>
        
    </LinearLayout>
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        
        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:scaleX="1.1"
            android:scaleY="1.1"
            android:src="@drawable/ic_copy" />

        <com.endiq.turtlelauncher.ui.view.AnimTextView
            android:id="@+id/copy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/background_item"
            android:gravity="center_horizontal"
            android:paddingVertical="@dimen/_12sdp"
            android:paddingHorizontal="@dimen/_20sdp"
            android:text="@string/version_manager_copy"
            app:ripple_for_text="true"/>
        
    </LinearLayout>
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:scaleX="1.1"
            android:scaleY="1.1"
            android:src="@drawable/ic_share" />

        <com.endiq.turtlelauncher.ui.view.AnimTextView
            android:id="@+id/exportModpack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/background_item"
            android:gravity="center_horizontal"
            android:paddingVertical="@dimen/_12sdp"
            android:paddingHorizontal="@dimen/_20sdp"
            android:text="@string/version_manager_export_modpack"
            app:ripple_for_text="true"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:scaleX="1.1"
            android:scaleY="1.1"
            android:src="@drawable/ic_share" />

        <com.endiq.turtlelauncher.ui.view.AnimTextView
            android:id="@+id/exportMrpack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/background_item"
            android:gravity="center_horizontal"
            android:paddingVertical="@dimen/_12sdp"
            android:paddingHorizontal="@dimen/_20sdp"
            android:text="@string/version_manager_export_mrpack"
            app:ripple_for_text="true"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:scaleX="1.1"
            android:scaleY="1.1"
            android:src="@drawable/ic_profile_mods" />

        <com.endiq.turtlelauncher.ui.view.AnimTextView
            android:id="@+id/depGraph"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/background_item"
            android:gravity="center_horizontal"
            android:paddingVertical="@dimen/_12sdp"
            android:paddingHorizontal="@dimen/_20sdp"
            android:text="@string/version_manager_dep_graph"
            app:ripple_for_text="true"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        
        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:scaleX="1.2"
            android:scaleY="1.2"
            android:src="@drawable/ic_menu_delete_forever" />

        <com.endiq.turtlelauncher.ui.view.AnimTextView
            android:id="@+id/delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/background_item"
            android:gravity="center_horizontal"
            android:paddingVertical="@dimen/_12sdp"
            android:paddingHorizontal="@dimen/_20sdp"
            android:text="@string/version_manager_delete"
            app:ripple_for_text="true"/>
        
    </LinearLayout>

    </LinearLayout>
    </ScrollView>

</LinearLayout>