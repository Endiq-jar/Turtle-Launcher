<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_app"
    tools:ignore="UseSwitchCompatOrMaterialXml">

    <LinearLayout
        android:id="@+id/sub_settings_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingVertical="@dimen/space_m">

        <ImageButton
            android:id="@+id/sub_settings_back_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_down"
            android:rotation="90"
            android:tint="@color/turtle_text_secondary"
            android:contentDescription="@string/generic_return"/>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/space_s"
            android:src="@drawable/ic_setting_experimental"
            android:tint="@color/accent_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:text="@string/setting_category_experimental"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/turtle_text_primary"/>
    </LinearLayout>

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        tools:ignore="UseSwitchCompatOrMaterialXml">
    
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_12sdp"
            android:orientation="vertical"
            android:paddingVertical="@dimen/_12sdp">
    
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/experimental_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/background_card"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_2sdp"
                android:paddingVertical="@dimen/_12sdp">
    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:text="@string/setting_category_experimental_patches"
                    android:textColor="@color/accent_primary" />
    
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/dump_shaders_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
    
                    <TextView
                        android:id="@+id/dump_shaders_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/dump_shaders"
                        android:text="@string/setting_shader_dump_title"
                        android:textColor="@color/turtle_primary_text" />
    
                    <TextView
                        android:id="@+id/dump_shaders_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/dump_shaders_title"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/dump_shaders"
                        android:text="@string/setting_shader_dump_desc" />
    
                    <Switch
                        android:id="@+id/dump_shaders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
    
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/bigCoreAffinity_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
    
                    <TextView
                        android:id="@+id/bigCoreAffinity_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/bigCoreAffinity"
                        android:text="@string/setting_force_big_core_title"
                        android:textColor="@color/turtle_primary_text" />
    
                    <TextView
                        android:id="@+id/bigCoreAffinity_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/bigCoreAffinity_title"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/bigCoreAffinity"
                        android:text="@string/setting_force_big_core_desc" />
    
                    <Switch
                        android:id="@+id/bigCoreAffinity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
    
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/fastBoot_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
    
                    <TextView
                        android:id="@+id/fastBoot_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/fastBoot"
                        android:text="@string/setting_fast_boot_title"
                        android:textColor="@color/turtle_primary_text" />
    
                    <TextView
                        android:id="@+id/fastBoot_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/fastBoot_title"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/fastBoot"
                        android:text="@string/setting_fast_boot_desc" />
    
                    <Switch
                        android:id="@+id/fastBoot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
    
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/modConflictDetection_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
    
                    <TextView
                        android:id="@+id/modConflictDetection_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/modConflictDetection"
                        android:text="@string/setting_mod_conflict_detection_title"
                        android:textColor="@color/turtle_primary_text" />
    
                    <TextView
                        android:id="@+id/modConflictDetection_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/modConflictDetection_title"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/modConflictDetection"
                        android:text="@string/setting_mod_conflict_detection_desc" />
    
                    <Switch
                        android:id="@+id/modConflictDetection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
    
                <!-- TurtleLauncher: "Add Multiple LWJGL versions" (Compatibility Improvements, item 16) -->
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/lwjglCompatMode_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
    
                    <TextView
                        android:id="@+id/lwjglCompatMode_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentEnd="true"
                        android:text="@string/setting_lwjgl_compat_mode_title"
                        android:textColor="@color/turtle_primary_text" />
    
                    <TextView
                        android:id="@+id/lwjglCompatMode_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/lwjglCompatMode_title"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentEnd="true"
                        android:text="@string/setting_lwjgl_compat_mode_summary" />
    
                    <TextView
                        android:id="@+id/lwjglCompatMode_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/lwjglCompatMode_summary"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentEnd="true"
                        android:text="@string/setting_lwjgl_compat_mode_auto" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
    
                <!-- TurtleLauncher: "Background Services" (item 20) -->
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/backgroundServiceOptimization_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
    
                    <TextView
                        android:id="@+id/backgroundServiceOptimization_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/backgroundServiceOptimization"
                        android:text="@string/setting_background_service_optimization_title"
                        android:textColor="@color/turtle_primary_text" />
    
                    <TextView
                        android:id="@+id/backgroundServiceOptimization_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/backgroundServiceOptimization_title"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/backgroundServiceOptimization"
                        android:text="@string/setting_background_service_optimization_summary" />
    
                    <Switch
                        android:id="@+id/backgroundServiceOptimization"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
    
            </androidx.appcompat.widget.LinearLayoutCompat>
    
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/support_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/background_card"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_2sdp"
                android:paddingVertical="@dimen/_12sdp">
    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:text="@string/setting_category_support"
                    android:textColor="@color/accent_primary" />
    
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/tcVibrateDuration_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground">
    
                    <TextView
                        android:id="@+id/tcVibrateDuration_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:text="@string/setting_touch_controller_vibrate_duration_title"
                        android:textColor="@color/turtle_primary_text" />
    
                    <TextView
                        android:id="@+id/tcVibrateDuration_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tcVibrateDuration_title"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:text="@string/setting_touch_controller_vibrate_duration_desc" />
    
                    <SeekBar
                        android:id="@+id/tcVibrateDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/tcVibrateDuration_value"
                        android:layout_alignBottom="@+id/tcVibrateDuration_value"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/tcVibrateDuration_value"
                        android:max="500"
                        android:min="80" />
    
                    <TextView
                        android:id="@+id/tcVibrateDuration_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tcVibrateDuration_summary"
                        android:layout_alignParentEnd="true"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:layout_marginEnd="@dimen/_12sdp"
                        tools:text="0" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
    
            </androidx.appcompat.widget.LinearLayoutCompat>
    
    
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/plugin_update_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/background_card"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_2sdp"
                android:paddingVertical="@dimen/_12sdp">
    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:text="@string/setting_category_plugin_update"
                    android:textColor="@color/accent_primary" />
    
                <!-- Auto-check on launch -->
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/autoCheckPluginUpdates_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
                    <TextView
                        android:id="@+id/autoCheckPluginUpdates_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/autoCheckPluginUpdates"
                        android:text="@string/setting_plugin_update_auto_title"
                        android:textColor="@color/turtle_primary_text" />
                    <TextView
                        android:id="@+id/autoCheckPluginUpdates_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/autoCheckPluginUpdates_title"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/autoCheckPluginUpdates"
                        android:text="@string/setting_plugin_update_auto_desc" />
                    <Switch
                        android:id="@+id/autoCheckPluginUpdates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
    
                <!-- Manual check button -->
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/checkPluginUpdates_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
                    <TextView
                        android:id="@+id/checkPluginUpdates_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_plugin_update_check_now_title"
                        android:textColor="@color/turtle_primary_text" />
                    <TextView
                        android:id="@+id/checkPluginUpdates_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/checkPluginUpdates_title"
                        android:text="@string/setting_plugin_update_check_now_desc" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
    
                <!-- Crash diagnostics telemetry (local counts only, never uploaded) -->
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/crashDiagnostics_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
                    <TextView
                        android:id="@+id/crashDiagnostics_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_crash_diagnostics_title"
                        android:textColor="@color/turtle_primary_text" />
                    <TextView
                        android:id="@+id/crashDiagnostics_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/crashDiagnostics_title"
                        android:text="@string/setting_crash_diagnostics_desc" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
    
            </androidx.appcompat.widget.LinearLayoutCompat>
    
            <!-- Advanced Tools -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/advanced_tools_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/background_card"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_2sdp"
                android:paddingVertical="@dimen/_12sdp">
    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:text="@string/setting_category_v10_tools"
                    android:textColor="@color/accent_primary" />
    
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/exportSettings_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
                    <TextView
                        android:id="@+id/exportSettings_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_export_settings_title"
                        android:textColor="@color/turtle_primary_text" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/exportSettings_title"
                        android:text="@string/setting_export_settings_desc" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
    
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/importSettings_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_import_settings_title"
                        android:textColor="@color/turtle_primary_text" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_import_settings_desc" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
    
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/crashHistory_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_crash_history_title"
                        android:textColor="@color/turtle_primary_text" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_crash_history_desc" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
    
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/crashRuleEditor_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_crash_rule_editor_title"
                        android:textColor="@color/turtle_primary_text" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_crash_rule_editor_desc" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
    
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/aiCrashHelp_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
    
                    <TextView
                        android:id="@+id/aiCrashHelp_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/aiCrashHelp"
                        android:text="@string/setting_ai_crash_help_title"
                        android:textColor="@color/turtle_primary_text" />
    
                    <TextView
                        android:id="@+id/aiCrashHelp_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/aiCrashHelp_title"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/aiCrashHelp"
                        android:text="@string/setting_ai_crash_help_desc" />
    
                    <Switch
                        android:id="@+id/aiCrashHelp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:checked="false"/>
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
    
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/aiCrashHelpApiKey_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_ai_crash_help_key_title"
                        android:textColor="@color/turtle_primary_text" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_ai_crash_help_key_desc" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
    
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/aiSkinFilter_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
    
                    <TextView
                        android:id="@+id/aiSkinFilter_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/aiSkinFilter"
                        android:text="@string/setting_ai_skin_filter_title"
                        android:textColor="@color/turtle_primary_text" />
    
                    <TextView
                        android:id="@+id/aiSkinFilter_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/aiSkinFilter_title"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/aiSkinFilter"
                        android:text="@string/setting_ai_skin_filter_desc" />
    
                    <Switch
                        android:id="@+id/aiSkinFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:checked="false"/>
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
    
