<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/assistant_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingVertical="@dimen/space_m"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_down"
            android:rotation="90"
            android:tint="@color/turtle_text_secondary"
            android:contentDescription="@string/generic_return"/>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/space_s"
            android:src="@drawable/ic_ai_assistant"
            android:tint="@color/accent_primary"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_s"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_chat_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/turtle_text_primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_chat_subtitle"
                android:textSize="11sp"
                android:textColor="@color/turtle_text_secondary"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/clear_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="@dimen/space_s"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_menu_close_clear_cancel"
            android:tint="@color/turtle_text_secondary"
            android:contentDescription="@string/generic_clear"/>
    </LinearLayout>

    <!-- Messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_message_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingVertical="@dimen/space_s"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/assistant_header"
        app:layout_constraintBottom_toTopOf="@id/suggestion_scroller"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_chat_message"/>

    <!-- Suggestion chips: follow-ups for the last answer, or starter prompts when empty.
         Populated at runtime by AiChatFragment (plain TextViews in this LinearLayout). -->
    <HorizontalScrollView
        android:id="@+id/suggestion_scroller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="@dimen/space_l"
        app:layout_constraintBottom_toTopOf="@id/assistant_input_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/suggestion_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/space_xs"/>
    </HorizontalScrollView>

    <!-- Input -->
    <LinearLayout
        android:id="@+id/assistant_input_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingVertical="@dimen/space_m"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/chat_message_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/background_edit_box"
            android:padding="@dimen/space_m"
            android:hint="@string/ai_chat_input_hint"
            android:textSize="14sp"
            android:textColor="@color/turtle_text_primary"
            android:textColorHint="@color/turtle_text_secondary"
            android:maxLines="4"
            android:inputType="textMultiLine|textCapSentences"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"/>

        <ImageButton
            android:id="@+id/chat_send_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/space_s"
            android:background="@drawable/background_grid_card"
            android:src="@drawable/ic_chevron_down"
            android:rotation="-90"
            android:tint="@color/accent_primary"
            android:contentDescription="@string/chat_send"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
