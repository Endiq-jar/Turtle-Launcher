<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/terracotta_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingVertical="@dimen/space_m"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_down"
            android:rotation="90"
            android:tint="@color/turtle_text_secondary"
            android:contentDescription="@string/generic_return"/>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/space_s"
            android:src="@drawable/ic_globe"
            android:tint="@color/accent_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:text="@string/terracotta_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/turtle_text_primary"/>
    </LinearLayout>

    <!-- ===================== Waiting: host / join entry ===================== -->
    <LinearLayout
        android:id="@+id/waiting_group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingTop="@dimen/space_l"
        app:layout_constraintTop_toBottomOf="@id/terracotta_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/terracotta_waiting_subtitle"
            android:textSize="13sp"
            android:textColor="@color/turtle_text_secondary"
            android:layout_marginBottom="@dimen/space_l"/>

        <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
            android:id="@+id/host_button"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/background_grid_card"
            android:layout_marginBottom="@dimen/space_s"
            app:ripple_for_relative="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/space_m"
                android:src="@drawable/ic_add_new"
                android:tint="@color/accent_primary"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="60dp"
                android:text="@string/terracotta_host_button"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/turtle_text_primary"/>
        </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

        <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
            android:id="@+id/join_button"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/background_grid_card"
            android:layout_marginBottom="@dimen/space_s"
            app:ripple_for_relative="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/space_m"
                android:src="@drawable/ic_launch_link"
                android:tint="@color/accent_primary"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="60dp"
                android:text="@string/terracotta_join_button"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/turtle_text_primary"/>
        </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

        <!-- Revealed under Join - code entry, no separate dialog -->
        <LinearLayout
            android:id="@+id/join_code_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginTop="@dimen/space_s">

            <EditText
                android:id="@+id/join_code_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/background_edit_box"
                android:padding="@dimen/space_m"
                android:hint="@string/terracotta_join_code_hint"
                android:textSize="14sp"
                android:textColor="@color/turtle_text_primary"
                android:textColorHint="@color/turtle_text_secondary"
                android:maxLines="1"
                android:imeOptions="actionGo"
                android:inputType="textNoSuggestions"
                android:importantForAutofill="no"/>

            <ImageButton
                android:id="@+id/join_code_submit"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/space_s"
                android:background="@drawable/background_grid_card"
                android:src="@drawable/ic_chevron_down"
                android:rotation="-90"
                android:tint="@color/accent_primary"
                android:contentDescription="@string/terracotta_join_button"/>
        </LinearLayout>

        <TextView
            android:id="@+id/join_code_validation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textSize="12sp"
            android:layout_marginTop="@dimen/space_xs"/>

        <!-- Custom EasyTier server node override - ported from TurtleLauncher PR #1496
             (closes ZL2#1486, the exact "Cannot find scaffolding server"/PingHostFail join
             failure this screen warns about via terracotta_join_known_issue). Off by
             default; leaving the field blank while enabled falls back to the default node,
             same as upstream. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/space_m">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/terracotta_custom_node_list"
                android:textSize="13sp"
                android:textColor="@color/turtle_text_primary"/>
            <Switch
                android:id="@+id/custom_node_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <EditText
            android:id="@+id/custom_node_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_edit_box"
            android:padding="@dimen/space_m"
            android:hint="@string/terracotta_custom_node_list_hint"
            android:textSize="14sp"
            android:textColor="@color/turtle_text_primary"
            android:textColorHint="@color/turtle_text_secondary"
            android:maxLines="1"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:importantForAutofill="no"
            android:visibility="gone"
            android:layout_marginTop="@dimen/space_xs"/>

        <!-- TurtleLauncher: one-tap preset for EasyTier's official public shared node
             (tcp://public.easytier.top:11010), so people hitting the known join-failure
             issue above don't have to go find/type a node URL by hand. Purely a shortcut
             that fills the field above - the manual field/switch keep working exactly as
             before for anyone who wants a different node. -->
        <TextView
            android:id="@+id/custom_node_easytier_preset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/space_xs"
            android:paddingHorizontal="@dimen/space_s"
            android:paddingVertical="4dp"
            android:background="@drawable/background_item"
            android:text="@string/terracotta_use_easytier_node"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/accent_primary"
            android:visibility="gone"/>

        <!-- TurtleLauncher: live relay-node readout. Joining fails with "Cannot find
             scaffolding server" when host and guest never land in a common EasyTier network,
             which almost always means every shared/relay node was dead. Showing the count and
             the node actually being used turns a mystery failure into something the user can
             see and work around. -->
        <TextView
            android:id="@+id/relay_node_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/turtle_text_secondary"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/terracotta_relay_status_checking"/>

        <!-- Core versions (Terracotta / EasyTier), same info Zalith Launcher 2 shows in
             its multiplayer dialog - what to quote when a connection bug is reported.
             Filled from Terracotta.getMetadata() once the native backend is up. -->
        <TextView
            android:id="@+id/terracotta_version_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/turtle_text_secondary"
            android:layout_marginTop="@dimen/space_xs"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- ===================== Loading: any in-between state ===================== -->
    <LinearLayout
        android:id="@+id/loading_group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/terracotta_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"/>

        <TextView
            android:id="@+id/loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:textSize="13sp"
            android:textColor="@color/turtle_text_secondary"/>

        <TextView
            android:id="@+id/loading_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:padding="@dimen/space_s"
            android:text="@string/terracotta_cancel"
            android:textSize="13sp"
            android:textColor="@color/accent_primary"/>
    </LinearLayout>

    <!-- ===================== Connected: info + player list + chat ===================== -->
    <LinearLayout
        android:id="@+id/connected_group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/terracotta_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/background_card"
            android:padding="@dimen/space_m"
            android:layout_margin="@dimen/space_l"
            android:layout_marginBottom="@dimen/space_s">

            <TextView
                android:id="@+id/connected_info_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/turtle_text_secondary"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/space_xs">

                <TextView
                    android:id="@+id/connected_info_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="@color/turtle_text_primary"
                    android:textIsSelectable="true"/>

                <ImageButton
                    android:id="@+id/connected_info_copy"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_copy"
                    android:tint="@color/accent_primary"
                    android:contentDescription="@string/terracotta_copy"/>
            </LinearLayout>

            <TextView
                android:id="@+id/connected_players"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textSize="12sp"
                android:textColor="@color/turtle_text_secondary"/>

            <TextView
                android:id="@+id/connected_leave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:padding="@dimen/space_xs"
                android:text="@string/terracotta_leave"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/turtle_error"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_message_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/space_l"
            android:paddingVertical="@dimen/space_s"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_l"
            android:paddingVertical="@dimen/space_m">

            <EditText
                android:id="@+id/chat_message_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/background_edit_box"
                android:padding="@dimen/space_m"
                android:hint="@string/terracotta_chat_input_hint"
                android:textSize="14sp"
                android:textColor="@color/turtle_text_primary"
                android:textColorHint="@color/turtle_text_secondary"
                android:maxLines="4"
                android:inputType="textMultiLine|textCapSentences"
                android:importantForAutofill="no"/>

            <ImageButton
                android:id="@+id/chat_send_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/space_s"
                android:background="@drawable/background_grid_card"
                android:src="@drawable/ic_chevron_down"
                android:rotation="-90"
                android:tint="@color/accent_primary"
                android:contentDescription="@string/chat_send"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ===================== Exception ===================== -->
    <LinearLayout
        android:id="@+id/exception_group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:paddingHorizontal="@dimen/space_xl"
        app:layout_constraintTop_toBottomOf="@id/terracotta_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_warning"
            android:tint="@color/turtle_error"/>

        <TextView
            android:id="@+id/exception_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:textSize="13sp"
            android:textColor="@color/turtle_text_secondary"
            android:gravity="center"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_l">

            <TextView
                android:id="@+id/exception_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_s"
                android:text="@string/generic_return"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/accent_primary"/>

            <TextView
                android:id="@+id/exception_export_logs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_l"
                android:padding="@dimen/space_s"
                android:text="@string/terracotta_export_logs"
                android:textSize="13sp"
                android:textColor="@color/turtle_text_secondary"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
