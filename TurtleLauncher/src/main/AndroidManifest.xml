<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:glEsVersion="0x00020000" />
    <uses-feature
        android:name="android.hardware.type.pc"
        android:required="false" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- Required since targetSdk 34/Android 14 to run a foregroundServiceType="mediaProjection"
         service - see ScreenRecorderAudioService's class doc for why ScreenRecorder's in-game
         audio capture needs one even though it never mirrors the display. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE"/>

    <application
        android:name="net.kdt.pojavlaunch.TurtleApplication"
        android:allowBackup="true"
        android:allowNativeHeapPointerTagging="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:appCategory="game"
        android:hasFragileUserData="true"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:isGame="true"
        android:label="Turtle Launcher"
        android:process=":launcher"
        android:resizeableActivity="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="r"
        tools:ignore="DiscouragedApi" >
        <!-- TurtleLauncher: opts every activity into Android 13+'s predictive-back gesture
             (animated swipe-back preview) by default - every launcher/settings/fragment
             screen here already goes through OnBackPressedDispatcher (see ZHTools.onBackPressed
             and each Fragment's back handling), which is exactly the API predictive back is
             built on top of, so this is a free upgrade for all of them. MainActivity is the
             one deliberate exception - see its own android:enableOnBackInvokedCallback="false"
             below for why it opts back out. -->
        <meta-data
            android:name="android.max_aspect"
            android:value="ratio_float" />
        <activity
            android:name="com.endiq.turtlelauncher.ui.activity.SplashActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation"
            android:screenOrientation="sensorLandscape" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="net.kdt.pojavlaunch.MissingStorageActivity"
            android:exported="false"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name="net.kdt.pojavlaunch.LauncherActivity"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name="com.endiq.turtlelauncher.ui.activity.ErrorActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation"
            android:theme="@style/CustomDialogStyle"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name="com.endiq.turtlelauncher.ui.activity.ConfigEditorActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="net.kdt.pojavlaunch.ShowErrorActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|keyboard|navigation"
            android:theme="@style/Theme.AppCompat.DayNight.Dialog" />
        <activity
            android:process=":gui_installer"
            android:name="net.kdt.pojavlaunch.JavaGUILauncherActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name="net.kdt.pojavlaunch.CustomControlsActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|keyboard|navigation"
            android:exported="false"
            android:screenOrientation="sensorLandscape" >
            <intent-filter>
                <action android:name=".CustomControlsActivity" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- TurtleLauncher: MainActivity (the actual running-game window) opts back OUT of
             the app-level predictive-back callback above. It has no OnBackPressedCallback at
             all - MinecraftGLSurface/dispatchKeyEvent's raw KEYCODE_BACK interception is what
             maps Back to in-game ESC (opening the pause menu). If predictive back were left
             enabled here, a gesture-nav swipe-back would bypass that KeyEvent entirely and go
             straight to OnBackInvokedDispatcher with nothing registered to consume it -
             finishing the Activity and silently kicking the player out of their game instead
             of opening the pause menu. Explicit "false" here overrides the "true" default set
             on <application> above; this is Android's documented per-activity opt-out. -->
        <activity
            android:name="net.kdt.pojavlaunch.MainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation"
            android:launchMode="singleTop"
            android:process=":game"
            android:enableOnBackInvokedCallback="false"
            android:screenOrientation="sensorLandscape" />

        <provider
            android:name="net.kdt.pojavlaunch.scoped.FolderProvider"
            android:authorities="@string/storageProviderAuthorities"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <!-- Shizuku/Sui: this is what acquires the privileged binder for us and hands it to
             ShizukuManager (see feature/shizuku). It is the documented, required manifest
             entry for the `provider` artifact - without it the binder is never delivered and
             Shizuku silently stays unavailable. android:permission guards the provider so no
             ordinary app can query it; only Shizuku (and the system) can. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <service
            android:name="net.kdt.pojavlaunch.services.ProgressService"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Tracks progress of local background tasks (downloads, asset extraction, version installs) and keeps the process alive while they run. Not data sync with a remote server."/>
        </service>
        <service android:name="net.kdt.pojavlaunch.services.GameService" android:process=":game"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="This application is intended to run a 3rd-party piece of software which cannot be managed using the activity's saved instance state. This service is used for background persistence of this piece of software."/>
        </service>
        <!-- TurtleLauncher: see ScreenRecorderAudioService's class doc - required so
             ScreenRecorder's in-game audio capture (MediaProjection-authorized, audio only,
             no display mirroring) is allowed to use the MediaProjection it obtains. -->
        <service
            android:name="net.kdt.pojavlaunch.services.ScreenRecorderAudioService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false"/>

        <!-- Terracotta P2P connection for the Friends/LAN feature. permission+intent-filter
             here are mandatory Android requirements for every VpnService subclass, not
             optional boilerplate - the system uses them to verify only this app's own
             VPN service can bind to the tunnel it creates. -->
        <service
            android:name="com.endiq.turtlelauncher.feature.terracotta.TerracottaVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains the peer-to-peer connection used by the Friends/LAN play feature."/>
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
    <queries>
        <!-- Shizuku: needed to tell "Shizuku is not installed" apart from "Shizuku is
             installed but its service has not been started", which are two different
             instructions for the user. Package visibility is filtered by default from
             Android 11 onwards, so without this the query always comes back empty. -->
        <package android:name="moe.shizuku.privileged.api"/>
        <package android:name="net.kdt.pojavlaunch.ffmpeg"/>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>
</manifest>