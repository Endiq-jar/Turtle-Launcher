# 로컬에서 릴리스 서명을 하려면 이 파일을 keystore.properties 로 복사해 채운다.
# CI 에서는 대신 환경변수를 쓴다:
#   FLAME_KEYSTORE_PATH · FLAME_KEYSTORE_PASSWORD · FLAME_KEY_ALIAS · FLAME_KEY_PASSWORD
#
# ⚠️ keystore.properties 와 .keystore 파일은 .gitignore 에 걸려 있다. 풀지 말 것.
storeFile=keystore/flamelauncher-release.keystore
storePassword=
keyAlias=flamelauncher
keyPassword=
