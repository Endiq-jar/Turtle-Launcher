<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="turtle_AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowAnimationStyle">@style/turtle_NoAnimations</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/turtle_bg_deep</item>
        <item name="android:navigationBarColor">@color/turtle_bg_deep</item>
        <item name="android:windowBackground">@color/turtle_bg_deep</item>
        <item name="android:scrollbarThumbHorizontal">@color/turtle_accent_primary</item>
        <item name="android:scrollbarThumbVertical">@color/turtle_accent_primary</item>
        <item name="android:textSize">@dimen/turtle_ssp_12</item>
        <item name="android:textColor">@color/turtle_turtle_text_primary</item>
        <item name="android:fontFamily">@font/turtle_proxima_nova_extrabold</item>
        <item name="fontFamily">@font/turtle_proxima_nova_extrabold</item>
        <item name="colorPrimary">@color/turtle_accent_primary</item>
        <item name="colorPrimaryDark">@color/turtle_bg_deep</item>
        <item name="colorAccent">@color/turtle_turtle_accent_glow</item>
        <item name="colorSurface">@color/turtle_turtle_bg_surface</item>
        <item name="colorOnSurface">@color/turtle_turtle_text_primary</item>
        <item name="colorSurfaceVariant">@color/turtle_turtle_bg_elevated</item>
        <item name="colorOutline">@color/turtle_turtle_border_default</item>
        <item name="colorError">@color/turtle_turtle_error</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <item name="shapeAppearanceSmallComponent">@style/turtle_ShapeAppearance.Turtle.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/turtle_ShapeAppearance.Turtle.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/turtle_ShapeAppearance.Turtle.Large</item>
        <item name="android:switchStyle">@style/turtle_Widget.Turtle.Switch</item>
        <item name="android:seekBarStyle">@style/turtle_Widget.Turtle.SeekBar</item>
    </style>

    <style name="turtle_Widget.Turtle.Switch" parent="android:Widget.Material.CompoundButton.Switch">
        <item name="android:track">@drawable/turtle_switch_track_selector</item>
        <item name="android:thumb">@drawable/turtle_switch_thumb_transparent</item>
        <item name="android:switchMinWidth">48dp</item>
    </style>

    <style name="turtle_Widget.Turtle.SeekBar" parent="android:Widget.Material.SeekBar">
        <item name="android:thumb">@drawable/turtle_seekbar_thumb</item>
        <item name="android:progressTint">@color/turtle_accent_primary</item>
        <item name="android:progressBackgroundTint">@color/turtle_turtle_border_default</item>
    </style>

    <style name="turtle_ThemeOverlay.Turtle.HighContrast" parent="">
        <item name="colorOutline">@color/turtle_turtle_hc_border</item>
        <item name="android:textColorSecondary">@color/turtle_turtle_hc_text_secondary</item>
        <item name="colorSurfaceVariant">@color/turtle_turtle_hc_surface</item>
    </style>

    <style name="turtle_ThemeOverlay.Turtle.Font.Sans" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>
    <style name="turtle_ThemeOverlay.Turtle.Font.Condensed" parent="">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="fontFamily">sans-serif-condensed</item>
    </style>
    <style name="turtle_ThemeOverlay.Turtle.Font.Serif" parent="">
        <item name="android:fontFamily">serif</item>
        <item name="fontFamily">serif</item>
    </style>
    <style name="turtle_ThemeOverlay.Turtle.Font.Monospace" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="fontFamily">monospace</item>
    </style>


    <style name="turtle_ShapeAppearance.Turtle.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">12dp</item>
    </style>
    <style name="turtle_ShapeAppearance.Turtle.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
    </style>
    <style name="turtle_ShapeAppearance.Turtle.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="turtle_CustomDialogStyle" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@drawable/turtle_bg_dialog</item>
        <item name="android:windowAnimationStyle">@style/turtle_DialogAnimation</item>
        <item name="colorPrimary">@color/turtle_accent_primary</item>
        <item name="colorSurface">@color/turtle_turtle_bg_surface</item>
        <item name="colorOnSurface">@color/turtle_turtle_text_primary</item>
        <item name="android:scrollbarThumbVertical">@color/turtle_accent_primary</item>
        <item name="android:textColor">@color/turtle_turtle_text_primary</item>
    </style>

    <style name="turtle_CustomAlertDialogTheme" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/turtle_bg_dialog</item>
        <item name="android:windowAnimationStyle">@style/turtle_DialogAnimation</item>
        <item name="colorPrimary">@color/turtle_accent_primary</item>
        <item name="colorSurface">@color/turtle_turtle_bg_surface</item>
        <item name="android:textColor">@color/turtle_turtle_text_primary</item>
    </style>


    <style name="turtle_DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/turtle_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/turtle_dialog_exit</item>
    </style>

    <style name="turtle_RoundedCornersImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="turtle_RoundImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>


    <style name="turtle_TurtleButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/turtle_accent_primary</item>
        <item name="android:textColor">@color/turtle_turtle_text_on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/turtle_radius_item</item>
        <item name="rippleColor">@color/turtle_turtle_accent_ripple</item>
    </style>


    <style name="turtle_TurtleButtonOutline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">@color/turtle_accent_primary</item>
        <item name="android:textColor">@color/turtle_accent_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/turtle_radius_item</item>
        <item name="rippleColor">@color/turtle_turtle_accent_ripple</item>
    </style>


    <style name="turtle_NoAnimations" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:taskOpenEnterAnimation">@null</item>
        <item name="android:taskOpenExitAnimation">@null</item>
        <item name="android:taskCloseEnterAnimation">@null</item>
        <item name="android:taskCloseExitAnimation">@null</item>
        <item name="android:taskToFrontEnterAnimation">@null</item>
        <item name="android:taskToFrontExitAnimation">@null</item>
        <item name="android:taskToBackEnterAnimation">@null</item>
        <item name="android:taskToBackExitAnimation">@null</item>
    </style>
    <style name="turtle_SettingsSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/turtle_turtle_text_secondary</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingTop">4dp</item>
    </style>

    <style name="turtle_ShareTrampolineTheme" parent="turtle_AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@style/turtle_NoAnimations</item>
    </style>
</resources>