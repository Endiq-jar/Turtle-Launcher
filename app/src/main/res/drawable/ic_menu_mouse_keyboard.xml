<!-- Mouse & Keyboard settings icon. Hand-drawn for TurtleLauncher in the same stroke
     language as the other ic_menu_* icons (2-unit round-cap strokes on a compact
     viewport): a vertical mouse outline with its scroll wheel on the left, and a
     keyboard suggested by four key dots plus a spacebar stroke on the right. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="18dp"
    android:tint="@color/black_or_white"
    android:viewportWidth="24"
    android:viewportHeight="18">
  <!-- mouse body: stadium outline -->
  <path
      android:pathData="M6.5,2A4.5,4.5 0,0 1,11 6.5L11,11.5A4.5,4.5 0,0 1,6.5 16A4.5,4.5 0,0 1,2 11.5L2,6.5A4.5,4.5 0,0 1,6.5 2Z"
      android:strokeWidth="2"
      android:fillColor="#00000000"
      android:strokeColor="@color/turtle_primary_text"/>
  <!-- scroll wheel -->
  <path
      android:pathData="M6.5,4.8L6.5,7.4"
      android:strokeWidth="2"
      android:fillColor="#00000000"
      android:strokeColor="@color/turtle_primary_text"
      android:strokeLineCap="round"/>
  <!-- key dots, same r0.23+stroke2 dot trick as ic_menu_custom_controls -->
  <path
      android:pathData="M15.5,5.5m-0.23,0a0.23,0.23 0,1 1,0.46 0a0.23,0.23 0,1 1,-0.46 0"
      android:strokeWidth="2"
      android:fillColor="#00000000"
      android:strokeColor="@color/turtle_primary_text"
      android:strokeLineCap="round"/>
  <path
      android:pathData="M19.5,5.5m-0.23,0a0.23,0.23 0,1 1,0.46 0a0.23,0.23 0,1 1,-0.46 0"
      android:strokeWidth="2"
      android:fillColor="#00000000"
      android:strokeColor="@color/turtle_primary_text"
      android:strokeLineCap="round"/>
  <path
      android:pathData="M15.5,9.5m-0.23,0a0.23,0.23 0,1 1,0.46 0a0.23,0.23 0,1 1,-0.46 0"
      android:strokeWidth="2"
      android:fillColor="#00000000"
      android:strokeColor="@color/turtle_primary_text"
      android:strokeLineCap="round"/>
  <path
      android:pathData="M19.5,9.5m-0.23,0a0.23,0.23 0,1 1,0.46 0a0.23,0.23 0,1 1,-0.46 0"
      android:strokeWidth="2"
      android:fillColor="#00000000"
      android:strokeColor="@color/turtle_primary_text"
      android:strokeLineCap="round"/>
  <!-- spacebar -->
  <path
      android:pathData="M15,13.5L20,13.5"
      android:strokeWidth="2"
      android:fillColor="#00000000"
      android:strokeColor="@color/turtle_primary_text"
      android:strokeLineCap="round"/>
</vector>
