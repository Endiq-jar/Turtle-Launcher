<?xml version='1.0' encoding='utf-8'?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/turtle_launch_button_ripple">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/turtle_launch_button_pressed" />
                    <corners android:radius="@dimen/turtle_radius_dialog" />
                </shape>
            </item>
            <item android:state_hovered="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/turtle_launch_button_hover" />
                    <corners android:radius="@dimen/turtle_radius_dialog" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/turtle_launch_button_color" />
                    <corners android:radius="@dimen/turtle_radius_dialog" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>