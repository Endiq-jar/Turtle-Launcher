<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_app">

    <LinearLayout
        android:id="@+id/sub_settings_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingVertical="@dimen/space_m">

        <ImageButton
            android:id="@+id/sub_settings_back_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_down"
            android:rotation="90"
            android:tint="@color/turtle_text_secondary"
            android:contentDescription="@string/generic_return"/>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/space_s"
            android:src="@drawable/ic_menu_emotes"
            android:tint="@color/accent_primary"
            tools:ignore="ContentDescription"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:text="@string/emotes_screen_title"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/turtle_text_primary"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_l"
            android:paddingBottom="@dimen/space_s">

            <TextView
                android:id="@+id/emotes_mod_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/turtle_text_secondary"
                android:layout_marginBottom="@dimen/space_s"
                tools:text="@string/emotes_status_missing"/>

            <!-- Emote wheel key row: tap opens the KeyboardDialog picker; the stored value is a
                 GLFW keycode (AllSettings.emoteWheelKeycode) sent by the in-game menu button. -->
            <LinearLayout
                android:id="@+id/emotes_wheel_key_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/background_item"
                android:padding="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_s">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/emotes_wheel_key_title"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/turtle_text_primary"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/emotes_wheel_key_summary"
                    android:textSize="11sp"
                    android:textColor="@color/turtle_text_secondary"/>

                <TextView
                    android:id="@+id/emotes_wheel_key_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_primary"
                    tools:text="Key: B"/>
            </LinearLayout>

            <TextView
                android:id="@+id/emotes_folder_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/turtle_text_secondary"
                android:layout_marginBottom="@dimen/space_s"
                tools:text="Emotes are saved to: /storage/emulated/0/games/TurtleLauncher/.minecraft/emotes"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/space_s">

                <com.endiq.turtlelauncher.ui.view.AnimButton
                    android:id="@+id/install_emotecraft_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_s"
                    android:visibility="gone"
                    android:text="@string/emotes_install_button"/>

                <com.endiq.turtlelauncher.ui.view.AnimButton
                    android:id="@+id/open_browser_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/emotes_open_browser"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/emotes_site_hint"
                android:textSize="11sp"
                android:textColor="@color/turtle_text_secondary"
                android:layout_marginBottom="@dimen/space_s"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="480dp">

                <WebView
                    android:id="@+id/emotes_web_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <ProgressBar
                    android:id="@+id/emotes_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"/>

                <!-- TurtleLauncher NESTED-SCROLL FIX: this WebView sits inside the outer
                     NestedScrollView above (see that view's own comment), and WebView does
                     not implement NestedScrollingChild - Android's nested-scroll dispatch
                     between it and a NestedScrollView is heuristic and unreliable, so a
                     swipe meant to scroll further down the community library page can get
                     stolen by the outer scroll view instead, leaving the user stuck able to
                     see only the first row or two ("can't see more emotes"). These two
                     mini-FABs bypass gesture scrolling entirely by paging the WebView's own
                     content directly via View.pageUp/pageDown - reliable regardless of how
                     nested scroll negotiation behaves. -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/emotes_page_prev_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="@dimen/space_m"
                    android:contentDescription="@string/emotes_page_prev"
                    android:src="@drawable/ic_chevron_right"
                    android:rotation="180"
                    app:backgroundTint="@color/accent_primary"
                    app:tint="@color/background_app"
                    app:fabSize="mini"/>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/emotes_page_next_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="@dimen/space_m"
                    android:contentDescription="@string/emotes_page_next"
                    android:src="@drawable/ic_chevron_right"
                    app:backgroundTint="@color/accent_primary"
                    app:tint="@color/background_app"
                    app:fabSize="mini"/>
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
