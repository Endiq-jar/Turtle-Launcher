<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/_16sdp"
    tools:ignore="HardcodedText">

    <TextView
        android:id="@+id/tasks_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_tasks_dialog_title"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/turtle_primary_text"/>

    <TextView
        android:id="@+id/tasks_dialog_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:text="@string/main_tasks_dialog_empty"
        android:textColor="@color/turtle_text_secondary"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/tasks_dialog_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:orientation="vertical"/>

</LinearLayout>
