<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/dialog_min_width"
    android:orientation="vertical"
    android:padding="@dimen/_8sdp">

    <!-- Server name -->
    <TextView
        android:id="@+id/server_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:singleLine="true"
        android:textSize="@dimen/_14ssp"
        android:textStyle="bold" />

    <!-- Server type badge: authlib-injector (cyan) or nide8auth (orange) -->
    <TextView
        android:id="@+id/server_type_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_2sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        android:paddingHorizontal="@dimen/_6sdp"
        android:paddingVertical="@dimen/_2sdp"
        android:textSize="@dimen/_11ssp"
        android:textStyle="bold"
        android:background="@color/turtle_highlight_subtle"
        android:visibility="gone"
        tools:text="authlib-injector"
        tools:textColor="@color/accent_primary" />

    <!-- ely.by quick-fill hint -->
    <TextView
        android:id="@+id/elyby_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_4sdp"
        android:text="@string/other_login_elyby_hint"
        android:textColor="@color/turtle_warning"
        android:textSize="@dimen/_11ssp"
        android:visibility="gone" />

    <!-- Email / username -->
    <TextView
        android:id="@+id/email_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_8sdp"
        android:text="@string/other_login_email" />

    <com.endiq.turtlelauncher.ui.view.AnimEditText
        android:id="@+id/email_edit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_38sdp"
        android:layout_marginHorizontal="@dimen/_8sdp"
        android:autofillHints="emailAddress"
        android:background="@drawable/background_edit_box"
        android:hint="@string/generic_required"
        android:imeOptions="flagNoExtractUi"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="@dimen/_8sdp"
        tools:ignore="LabelFor" />

    <!-- Password -->
    <TextView
        android:id="@+id/password_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_8sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:text="@string/other_login_password" />

    <com.endiq.turtlelauncher.ui.view.AnimEditText
        android:id="@+id/password_edit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_38sdp"
        android:layout_marginHorizontal="@dimen/_8sdp"
        android:autofillHints="password"
        android:background="@drawable/background_edit_box"
        android:hint="@string/generic_required"
        android:imeOptions="flagNoExtractUi"
        android:inputType="textPassword"
        android:paddingHorizontal="@dimen/_8sdp"
        tools:ignore="LabelFor" />

    <!-- Register link -->
    <TextView
        android:id="@+id/registry_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_8sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="?attr/selectableItemBackground"
        android:text="@string/other_login_registry_now"
        android:textColor="@android:color/holo_green_dark" />

    <!-- Action buttons -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_4sdp"
        android:layout_marginTop="@dimen/_4sdp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <com.endiq.turtlelauncher.ui.view.AnimButton
            android:id="@+id/cancel_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/_2sdp"
            android:text="@android:string/cancel" />

        <com.endiq.turtlelauncher.ui.view.AnimButton
            android:id="@+id/login_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_2sdp"
            android:text="@string/generic_login" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
