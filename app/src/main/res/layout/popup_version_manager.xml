<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/_240sdp"
    android:layout_height="wrap_content"
    android:background="@drawable/background_card"
    android:padding="@dimen/_8sdp"
    android:orientation="vertical"
    android:elevation="@dimen/_8sdp"
    android:translationZ="4dp"
    tools:ignore="ContentDescription">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:src="@drawable/ic_profile_mods" />

                <com.endiq.turtlelauncher.ui.view.AnimTextView
                    android:id="@+id/shortcuts_mods"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:background="@drawable/background_item"
                    android:gravity="center_horizontal"
                    android:paddingVertical="@dimen/_12sdp"
                    android:paddingHorizontal="@dimen/_20sdp"
                    android:text="@string/version_manager_shortcuts_mods"
                    app:ripple_for_text="true"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:src="@drawable/ic_profile_folder" />

                <com.endiq.turtlelauncher.ui.view.AnimTextView
                    android:id="@+id/game_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:background="@drawable/background_item"
                    android:gravity="center_horizontal"
                    android:paddingVertical="@dimen/_12sdp"
                    android:paddingHorizontal="@dimen/_20sdp"
                    android:text="@string/version_manager_shortcuts_version_path"
                    app:ripple_for_text="true"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:src="@drawable/ic_profile_resource_pack" />

                <com.endiq.turtlelauncher.ui.view.AnimTextView
                    android:id="@+id/resource_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:background="@drawable/background_item"
                    android:gravity="center_horizontal"
                    android:paddingVertical="@dimen/_12sdp"
                    android:paddingHorizontal="@dimen/_20sdp"
                    android:text="@string/version_manager_shortcuts_resource_path"
                    app:ripple_for_text="true"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:scaleX="0.95"
                    android:scaleY="0.95"
                    android:src="@drawable/ic_profile_saves" />

                <com.endiq.turtlelauncher.ui.view.AnimTextView
                    android:id="@+id/world_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:background="@drawable/background_item"
                    android:gravity="center_horizontal"
                    android:paddingVertical="@dimen/_12sdp"
                    android:paddingHorizontal="@dimen/_20sdp"
                    android:text="@string/version_manager_shortcuts_world_path"
                    app:ripple_for_text="true"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:src="@drawable/ic_profile_shader_pack" />

                <com.endiq.turtlelauncher.ui.view.AnimTextView
                    android:id="@+id/shader_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:background="@drawable/background_item"
                    android:gravity="center_horizontal"
                    android:paddingVertical="@dimen/_12sdp"
                    android:paddingHorizontal="@dimen/_20sdp"
                    android:text="@string/version_manager_shortcuts_shader_path"
                    app:ripple_for_text="true"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:scaleX="0.95"
                    android:scaleY="0.95"
                    android:src="@drawable/ic_screenshot" />

                <com.endiq.turtlelauncher.ui.view.AnimTextView
                    android:id="@+id/screenshot_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:background="@drawable/background_item"
                    android:gravity="center_horizontal"
                    android:paddingVertical="@dimen/_12sdp"
                    android:paddingHorizontal="@dimen/_20sdp"
                    android:text="@string/version_manager_shortcuts_screenshot_path"
                    app:ripple_for_text="true"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:src="@drawable/ic_profile_logs" />

                <com.endiq.turtlelauncher.ui.view.AnimTextView
                    android:id="@+id/logs_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:background="@drawable/background_item"
                    android:gravity="center_horizontal"
                    android:paddingVertical="@dimen/_12sdp"
                    android:paddingHorizontal="@dimen/_20sdp"
                    android:text="@string/version_manager_shortcuts_logs_path"
                    app:ripple_for_text="true"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:src="@drawable/ic_profile_crash_report" />

                <com.endiq.turtlelauncher.ui.view.AnimTextView
                    android:id="@+id/crash_report_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:background="@drawable/background_item"
                    android:gravity="center_horizontal"
                    android:paddingVertical="@dimen/_12sdp"
                    android:paddingHorizontal="@dimen/_20sdp"
                    android:text="@string/version_manager_shortcuts_crash_report_path"
                    app:ripple_for_text="true"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@color/turtle_divider"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:src="@drawable/ic_setting" />

                <com.endiq.turtlelauncher.ui.view.AnimTextView
                    android:id="@+id/version_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:background="@drawable/background_item"
                    android:gravity="center_horizontal"
                    android:paddingVertical="@dimen/_12sdp"
                    android:paddingHorizontal="@dimen/_20sdp"
                    android:text="@string/setting_category_version"
                    app:ripple_for_text="true"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:scaleX="1.1"
                    android:scaleY="1.1"
                    android:src="@drawable/ic_edit" />

                <com.endiq.turtlelauncher.ui.view.AnimTextView
                    android:id="@+id/version_rename"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:background="@drawable/background_item"
                    android:gravity="center_horizontal"
                    android:paddingVertical="@dimen/_12sdp"
                    android:paddingHorizontal="@dimen/_20sdp"
                    android:text="@string/version_manager_rename"
                    app:ripple_for_text="true"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:scaleX="1.1"
                    android:scaleY="1.1"
                    android:src="@drawable/ic_copy" />

                <com.endiq.turtlelauncher.ui.view.AnimTextView
                    android:id="@+id/version_copy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:background="@drawable/background_item"
                    android:gravity="center_horizontal"
                    android:paddingVertical="@dimen/_12sdp"
                    android:paddingHorizontal="@dimen/_20sdp"
                    android:text="@string/version_manager_copy"
                    app:ripple_for_text="true"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:scaleX="1.2"
                    android:scaleY="1.2"
                    android:src="@drawable/ic_menu_delete_forever" />

                <com.endiq.turtlelauncher.ui.view.AnimTextView
                    android:id="@+id/version_delete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:background="@drawable/background_item"
                    android:gravity="center_horizontal"
                    android:paddingVertical="@dimen/_12sdp"
                    android:paddingHorizontal="@dimen/_20sdp"
                    android:text="@string/version_manager_delete"
                    app:ripple_for_text="true"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
