                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/showKeystrokesHud_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
                    <TextView
                        android:id="@+id/showKeystrokesHud_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/showKeystrokesHud"
                        android:text="@string/setting_hud_keystrokes_title"
                        android:textColor="@color/turtle_primary_text" />
                    <TextView
                        android:id="@+id/showKeystrokesHud_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/showKeystrokesHud_title"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/showKeystrokesHud"
                        android:text="@string/setting_hud_keystrokes_desc" />
                    <Switch
                        android:id="@+id/showKeystrokesHud"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/showMousestrokesHud_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
                    <TextView
                        android:id="@+id/showMousestrokesHud_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/showMousestrokesHud"
                        android:text="@string/setting_hud_mousestrokes_title"
