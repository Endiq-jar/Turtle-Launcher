                        android:layout_alignParentStart="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:text="@string/setting_game_menu_alpha_desc" />

                    <SeekBar
                        android:id="@+id/gameMenuAlpha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/gameMenuAlpha_value"
                        android:layout_alignBottom="@+id/gameMenuAlpha_value"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/gameMenuAlpha_value"
                        android:max="100"
                        android:min="20" />

                    <TextView
                        android:id="@+id/gameMenuAlpha_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/gameMenuAlpha_summary"
                        android:layout_alignParentEnd="true"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:layout_marginEnd="@dimen/_12sdp"
                        tools:text="0" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

                <include
                    android:id="@+id/game_menu_preview"
                    layout="@layout/view_game_info_hud"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/hud_modules_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/background_card"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_2sdp"
                android:paddingVertical="@dimen/_12sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:text="@string/setting_category_hud_modules"
                    android:textColor="@color/accent_primary" />

                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/showCpsHud_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
                    <TextView
                        android:id="@+id/showCpsHud_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/showCpsHud"
                        android:text="@string/setting_hud_cps_title"
                        android:textColor="@color/turtle_primary_text" />
                    <TextView
                        android:id="@+id/showCpsHud_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/showCpsHud_title"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/showCpsHud"
                        android:text="@string/setting_hud_cps_desc" />
                    <Switch
